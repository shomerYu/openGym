# Dependencies — restored with `npm ci` / `npm install`.
node_modules/

# Build output. `frontend/dist` is generated by `npm run build`; the native
# projects get their copy from `cap sync`, and android/ ios/ carry their own
# .gitignore for the rest.
dist/
build/

# Local environment and logs
.env
.env.local
*.log
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# Signing keys. A keystore in the working tree is one `git add -A` away from being published,
# and this repository is public — a leaked key lets anyone build an APK that installs as an
# update over a real one. Keep it outside the repo; keep a backup somewhere durable.
*.keystore
*.jks
*.p12
key.properties
